# The browser-facing API URL for a local Docker installation.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated browser origins permitted to call the controlled API.
BIOTRUST_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Keep "local" unless an authenticated, isolated online runner has been deployed.
BIOTRUST_EXECUTION_MODE=local

# Public origin used only to build absolute social metadata.
SITE_URL=http://localhost:3000
